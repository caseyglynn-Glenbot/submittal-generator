{
  "name": "Submittal Generator",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Generate Submittal",
        "formDescription": "Upload an Evoqua quote PDF. The completed submittal will be emailed to you within ~30 seconds.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Quote PDF",
              "fieldType": "file",
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Job Number",
              "placeholder": "e.g. 76284",
              "requiredField": true
            },
            {
              "fieldLabel": "Engineer Initials",
              "placeholder": "e.g. LRH",
              "requiredField": false
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thanks! Your submittal is being generated and will be emailed shortly."
            }
          }
        }
      },
      "id": "form-trigger",
      "name": "On Form Submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [240, 300],
      "webhookId": "submittal-generator"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SERVICE.onrender.com/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $credentials.submittalApi.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "quote_pdf",
              "inputDataFieldName": "Quote_PDF"
            },
            {
              "name": "job_number",
              "value": "={{ $json['Job Number'] }}"
            },
            {
              "name": "engineer_initials",
              "value": "={{ $json['Engineer Initials'] }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "submittal"
            }
          },
          "timeout": 120000
        }
      },
      "id": "call-service",
      "name": "Generate Submittal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "notes": "Replace URL with your Render service URL. API key stored as n8n credential."
    },
    {
      "parameters": {
        "fromEmail": "submittals@yourdomain.com",
        "toEmail": "={{ $('On Form Submission').item.json['Your Email'] }}",
        "subject": "=Submittal ready: Job #{{ $('On Form Submission').item.json['Job Number'] }}",
        "emailFormat": "text",
        "text": "=Your submittal package is attached.\n\nJob Number: {{ $('On Form Submission').item.json['Job Number'] }}\nEngineer: {{ $('On Form Submission').item.json['Engineer Initials'] }}\nQuote file: {{ $('On Form Submission').item.json['Quote_PDF'][0].filename }}\n\nThis was generated automatically. Reply to this email if anything looks wrong.",
        "attachments": "submittal",
        "options": {}
      },
      "id": "send-email",
      "name": "Email Submittal",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 300],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CRED_ID",
          "name": "SMTP"
        }
      },
      "notes": "Configure SMTP credentials in n8n Cloud (Gmail, SES, Postmark, etc.)"
    },
    {
      "parameters": {
        "fromEmail": "submittals@yourdomain.com",
        "toEmail": "={{ $('On Form Submission').item.json['Your Email'] }}",
        "subject": "=Submittal generation FAILED: Job #{{ $('On Form Submission').item.json['Job Number'] }}",
        "emailFormat": "text",
        "text": "=Sorry, submittal generation failed.\n\nJob Number: {{ $('On Form Submission').item.json['Job Number'] }}\nError: {{ $json.error?.message || $json.message || 'Unknown error' }}\n\nReply to this email so we can investigate.",
        "options": {}
      },
      "id": "send-error",
      "name": "Email Error",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 480],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CRED_ID",
          "name": "SMTP"
        }
      }
    }
  ],
  "connections": {
    "On Form Submission": {
      "main": [[{"node": "Generate Submittal", "type": "main", "index": 0}]]
    },
    "Generate Submittal": {
      "main": [[{"node": "Email Submittal", "type": "main", "index": 0}]],
      "error": [[{"node": "Email Error", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
